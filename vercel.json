{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm build:static",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "rewrites": [{ "source": "/(.*)", "destination": "/app.html" }],
  "headers": [
    { "source": "/llms(.*).txt", "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }] },
    { "source": "/docs/(.*).md", "headers": [{ "key": "Content-Type", "value": "text/markdown; charset=utf-8" }] }
  ]
}
