{
  "name": "@uiset/web",
  "version": "0.6.1",
  "description": "UISet's skins, kits and elements for Web Components, Vue, Svelte, Solid and plain HTML, on UI SDK's custom elements.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://uiset.dev/docs/web-components",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/superzero11/uiset.git",
    "directory": "web"
  },
  "bugs": "https://github.com/superzero11/uiset/issues",
  "keywords": [
    "ui-sdk",
    "web-components",
    "custom-elements",
    "design-system",
    "themes",
    "data-grid",
    "chat",
    "rich-text",
    "accessibility",
    "ai-agents"
  ],
  "files": ["dist"],
  "types": "./dist/types/web/src/uiset.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/web/src/uiset.d.ts",
      "default": "./dist/uiset.js"
    },
    "./uiset.css": "./dist/uiset.css"
  },
  "sideEffects": ["./dist/uiset.js", "./dist/uiset.css"],
  "scripts": {
    "prepublishOnly": "cd .. && pnpm web:build"
  },
  "peerDependencies": {
    "@ui-sdk/core": "0.1.0-beta.16",
    "@ui-sdk/web": "0.1.0-beta.16",
    "shiki": "^4.6.0"
  },
  "peerDependenciesMeta": {
    "shiki": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
